cmake_minimum_required(VERSION 3.16)
# Capture IDF registration without pretending this is an SDK compile.
macro(idf_component_register)
    cmake_parse_arguments(captured "" "" "SRCS;INCLUDE_DIRS;PRIV_INCLUDE_DIRS;REQUIRES;PRIV_REQUIRES" ${ARGN})
    return()
endmacro()
set(CONFIG_NAWSERVER_WEBSOCKET ${WITH_WEBSOCKET})
set(CONFIG_NAWSERVER_SSE ${WITH_SSE})
set(CONFIG_NAWSERVER_AUTH ${WITH_AUTH})
set(CONFIG_NAWSERVER_CLIENT_QUOTAS ${WITH_QUOTAS})
set(CONFIG_NAWSERVER_TCP_MANAGED ${WITH_MANAGED})
include("${REPOSITORY_ROOT}/CMakeLists.txt")
set(normalized_sources "")
foreach(source IN LISTS captured_SRCS)
    if(IS_ABSOLUTE "${source}")
        file(RELATIVE_PATH source "${REPOSITORY_ROOT}" "${source}")
    endif()
    list(APPEND normalized_sources "${source}")
endforeach()
function(require_source source enabled)
    if(enabled AND NOT "${source}" IN_LIST normalized_sources)
        message(FATAL_ERROR "Required source missing: ${source}")
    elseif(NOT enabled AND "${source}" IN_LIST normalized_sources)
        message(FATAL_ERROR "Disabled source compiled: ${source}")
    endif()
endfunction()
foreach(source src/http/http_server.cpp src/routing/pipeline.cpp src/routing/route.cpp
        src/http/wire/request_parser.cpp src/http/wire/response_writer.cpp
        src/backends/tcp/session_io.cpp src/backends/tcp/http_connection.cpp
        src/backends/tcp/connection_registry.cpp src/backends/tcp/http_backend.cpp
        src/backends/tcp/queued_transport.cpp
        src/backends/tcp/platform/idf_tcp.cpp src/backends/tcp/platform/idf_worker.cpp)
    require_source("${source}" ON)
endforeach()
foreach(source src/auth/basic_auth.cpp src/auth/handler_middleware.cpp)
    require_source("${source}" ${WITH_AUTH})
endforeach()
require_source(src/backends/tcp/http_connection_manager.cpp ${WITH_MANAGED})
foreach(source src/websocket/handler_ws.cpp src/websocket/wire/handshake.cpp
        src/websocket/wire/frame_codec.cpp src/backends/tcp/websocket_tx_pool.cpp
        src/backends/tcp/websocket_connection.cpp)
    require_source("${source}" ${WITH_WEBSOCKET})
endforeach()
foreach(source src/sse/encoder.cpp src/sse/backend.cpp src/sse/response_bridge.cpp
        src/sse/event_source.cpp src/sse/queued_adapter.cpp
        src/backends/tcp/sse_stream.cpp src/backends/tcp/tcp_sse.cpp)
    require_source("${source}" ${WITH_SSE})
endforeach()
foreach(source IN LISTS normalized_sources)
    if(source MATCHES "(httpd|web_server|backends/esp_idf\\.|esp_idf_websocket|sse/adapter\\.)")
        message(FATAL_ERROR "Removed native HTTPD source remains: ${source}")
    endif()
endforeach()
set(requirements ${captured_REQUIRES} ${captured_PRIV_REQUIRES})
if("esp_http_server" IN_LIST requirements OR "esp-tls" IN_LIST requirements)
    message(FATAL_ERROR "Common engine acquired HTTPD/TLS dependency")
endif()
foreach(required freertos lwip esp_timer)
    if(NOT "${required}" IN_LIST requirements)
        message(FATAL_ERROR "Missing platform dependency: ${required}")
    endif()
endforeach()
message(STATUS "SOURCE_PROFILE_PASS")