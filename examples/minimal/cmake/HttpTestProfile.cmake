# Derive the embedded board metadata from the actual IDF target, without editing UI sources.
function(nawserver_demo_write_http_profile target template output)
    if(NOT target MATCHES "^esp32[a-z0-9]*$")
        message(FATAL_ERROR "Missing or unsupported IDF target for the HTTP test profile: ${target}")
    endif()
    if(target STREQUAL "esp32")
        set(NAWSERVER_DEMO_HTTP_TEST_BOARD "ESP32")
    else()
        string(REGEX REPLACE "^esp32" "" NAWSERVER_DEMO_HTTP_TEST_SUFFIX "${target}")
        string(TOUPPER "${NAWSERVER_DEMO_HTTP_TEST_SUFFIX}" NAWSERVER_DEMO_HTTP_TEST_SUFFIX)
        set(NAWSERVER_DEMO_HTTP_TEST_BOARD "ESP32-${NAWSERVER_DEMO_HTTP_TEST_SUFFIX}")
    endif()
    configure_file("${template}" "${output}" @ONLY)
endfunction()
