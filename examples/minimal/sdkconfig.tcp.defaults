CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_NAWSERVER_WEBSOCKET=y
CONFIG_NAWSERVER_SSE=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_LWIP_NETIF_LOOPBACK=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
# S3 loopback diagnostics measured only 144 bytes free with an 8 KiB main stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
# S3 SSE open exceeded the 6 KiB default; measure the demo callback stack separately.
CONFIG_NAWSERVER_TCP_HTTP_STACK_SIZE=8192
