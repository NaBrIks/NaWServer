CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_NAWSERVER_TCP_MANAGED=y
CONFIG_NAWSERVER_WEBSOCKET=n
CONFIG_NAWSERVER_SSE=y
CONFIG_NAWSERVER_AUTH=n
CONFIG_NAWSERVER_CLIENT_QUOTAS=n
CONFIG_NAWSERVER_API_KEYS=y
CONFIG_NAWSERVER_TCP_HTTP_STACK_SIZE=8192
CONFIG_NAWSERVER_MCP=n
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
